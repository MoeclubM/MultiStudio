{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveTranslator",
  "version": "0.1.0",
  "identifier": "app.livetranslator.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LiveTranslator — 实时翻译",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Realtime ASR + LLM translation — mic / system audio, OpenAI-compatible endpoints",
    "longDescription": "LiveTranslator captures microphone or system audio, streams it through an OpenAI-compatible ASR endpoint for transcription and an OpenAI-compatible LLM for translation, with selectable source/target languages and low-latency streaming subtitles.",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "opener": {}
  }
}