{
  "name": "multistudio",
  "private": true,
  "version": "0.1.0",
  "description": "MultiStudio — local multimodal model workspace",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev:desktop",
    "build": "tsc --noEmit && vite build",
    "icons": "node scripts/generate-icons.mjs",
    "dev:desktop": "npm run audio:runtime && npm run llama:runtime && npm run backend:build && node --experimental-strip-types scripts/electron-dev.ts",
    "backend:build": "node --experimental-strip-types scripts/build-native.ts",
    "backend:release": "node --experimental-strip-types scripts/build-native.ts",
    "start": "npm run audio:runtime && npm run llama:runtime && npm run build && npm run backend:build && electron .",
    "desktop:pack": "npm run build && npm run backend:release && npm run runtime:stage && electron-builder --config electron-builder.cjs --dir --publish never",
    "desktop:dist": "npm run build && npm run backend:release && npm run runtime:stage && electron-builder --config electron-builder.cjs --publish never",
    "test:desktop": "npm run backend:build && node --test electron/tests/*.test.cjs",
    "test:electron": "npm run build && npm run backend:build && node --experimental-strip-types scripts/electron-smoke.ts",
    "audio:runtime": "node --experimental-strip-types scripts/stage-audiocpp.ts",
    "runtime:stage": "node --experimental-strip-types scripts/stage-runtime.ts && node --experimental-strip-types scripts/stage-licenses.ts",
    "llama:runtime": "node --experimental-strip-types scripts/stage-llama.ts",
    "release:version": "node --experimental-strip-types scripts/release-version.ts",
    "release:verify": "node --experimental-strip-types scripts/verify-package.ts",
    "test:unit": "node --test electron/tests/*.test.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "sherpa-onnx-node": "2.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.19",
    "electron": "^44.6.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.39",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.6",
    "typescript": "~5.5.4",
    "vite": "^5.4.8"
  },
  "author": "MultiStudio contributors",
  "license": "MIT"
}
