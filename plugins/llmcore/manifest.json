{
  "apiVersion": 1,
  "id": "multistudio.llmcore",
  "name": "llama.cpp",
  "version": "1.1.0",
  "entry": "index.cjs",
  "backends": {
    "llmcore": {
      "name": "llama.cpp",
      "capabilities": [
        "text"
      ]
    }
  },
  "nodes": {
    "llmcore.text": {
      "label": "本地文本",
      "group": "model",
      "input": "text",
      "output": "text",
      "icon": "sparkles",
      "defaults": {
        "modelId": "",
        "prompt": "{input}",
        "systemPrompt": "",
        "rememberHistory": false,
        "historyLimit": 12,
        "temperature": 0.4,
        "maxTokens": 1024,
        "device": "auto"
      },
      "fields": [
        {
          "key": "modelId",
          "label": "模型",
          "type": "model",
          "resource": "text",
          "backend": "llmcore"
        },
        {
          "key": "device",
          "label": "运行设备",
          "type": "select",
          "options": [
            {
              "value": "auto",
              "label": "自动"
            },
            {
              "value": "cpu",
              "label": "CPU"
            }
          ],
          "platformOptions": {
            "win32": [
              {
                "value": "auto",
                "label": "自动"
              },
              {
                "value": "cpu",
                "label": "CPU"
              },
              {
                "value": "vulkan",
                "label": "Vulkan（含 AMD）"
              }
            ],
            "darwin": [
              {
                "value": "auto",
                "label": "自动"
              },
              {
                "value": "cpu",
                "label": "CPU"
              },
              {
                "value": "metal",
                "label": "Apple Metal"
              }
            ]
          }
        },
        {
          "key": "prompt",
          "label": "提示词",
          "type": "textarea",
          "rows": 4,
          "maxLength": 32768,
          "placeholder": "{input}"
        },
        {
          "key": "systemPrompt",
          "label": "系统提示词",
          "type": "textarea",
          "rows": 3
        },
        {
          "key": "rememberHistory",
          "label": "保留上下文",
          "type": "boolean"
        },
        {
          "key": "historyLimit",
          "label": "历史轮数",
          "type": "number",
          "min": 1,
          "max": 20,
          "step": 1
        },
        {
          "key": "temperature",
          "label": "温度",
          "type": "number",
          "min": 0,
          "max": 1,
          "step": 0.1
        },
        {
          "key": "maxTokens",
          "label": "输出上限",
          "type": "number",
          "min": 16,
          "max": 8192,
          "step": 1
        }
      ],
      "context": true,
      "backend": "llmcore"
    },
    "llmcore.translate": {
      "label": "本地翻译",
      "group": "model",
      "input": "text",
      "output": "text",
      "icon": "languages",
      "defaults": {
        "modelId": "",
        "sourceLanguage": "自动检测",
        "targetLanguage": "中文",
        "temperature": 0.1,
        "maxTokens": 1024,
        "contextSentences": 2,
        "device": "auto"
      },
      "fields": [
        {
          "key": "modelId",
          "label": "模型",
          "type": "model",
          "resource": "text",
          "backend": "llmcore"
        },
        {
          "key": "device",
          "label": "运行设备",
          "type": "select",
          "options": [
            {
              "value": "auto",
              "label": "自动"
            },
            {
              "value": "cpu",
              "label": "CPU"
            }
          ],
          "platformOptions": {
            "win32": [
              {
                "value": "auto",
                "label": "自动"
              },
              {
                "value": "cpu",
                "label": "CPU"
              },
              {
                "value": "vulkan",
                "label": "Vulkan（含 AMD）"
              }
            ],
            "darwin": [
              {
                "value": "auto",
                "label": "自动"
              },
              {
                "value": "cpu",
                "label": "CPU"
              },
              {
                "value": "metal",
                "label": "Apple Metal"
              }
            ]
          }
        },
        {
          "key": "sourceLanguage",
          "label": "源语言",
          "type": "text"
        },
        {
          "key": "targetLanguage",
          "label": "目标语言",
          "type": "text"
        },
        {
          "key": "temperature",
          "label": "温度",
          "type": "number",
          "min": 0,
          "max": 1,
          "step": 0.1
        },
        {
          "key": "maxTokens",
          "label": "输出上限",
          "type": "number",
          "min": 16,
          "max": 8192,
          "step": 1
        },
        {
          "key": "contextSentences",
          "label": "上下文句数",
          "type": "number",
          "min": 0,
          "max": 8
        }
      ],
      "context": true,
      "backend": "llmcore"
    }
  },
  "templates": [
    {
      "id": "llmcore.chat",
      "label": "本地文本对话",
      "nodes": [
        {
          "kind": "text-input"
        },
        {
          "kind": "llmcore.text",
          "config": {
            "rememberHistory": true
          }
        },
        {
          "kind": "text-output"
        }
      ]
    }
  ]
}
