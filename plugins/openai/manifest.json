{
  "apiVersion": 1,
  "id": "multistudio.openai",
  "name": "OpenAI 兼容服务",
  "version": "1.0.0",
  "entry": "index.cjs",
  "backends": {
    "openai": {
      "name": "OpenAI 兼容服务",
      "capabilities": [
        "text",
        "asr",
        "tts",
        "text-streaming"
      ]
    }
  },
  "nodes": {
    "openai.text": {
      "label": "API 文本",
      "group": "model",
      "input": "text",
      "output": "text",
      "icon": "sparkles",
      "defaults": {
        "model": "",
        "prompt": "{input}",
        "systemPrompt": "",
        "rememberHistory": false,
        "historyLimit": 12,
        "temperature": 0.4,
        "maxTokens": 1024
      },
      "fields": [
        {
          "key": "model",
          "label": "模型",
          "type": "text",
          "placeholder": "默认模型"
        },
        {
          "key": "prompt",
          "label": "提示词",
          "type": "textarea",
          "rows": 4,
          "maxLength": 32768,
          "placeholder": "{input}"
        },
        {
          "key": "systemPrompt",
          "label": "系统提示词",
          "type": "textarea",
          "rows": 3
        },
        {
          "key": "rememberHistory",
          "label": "保留上下文",
          "type": "boolean"
        },
        {
          "key": "historyLimit",
          "label": "历史轮数",
          "type": "number",
          "min": 1,
          "max": 20,
          "step": 1
        },
        {
          "key": "temperature",
          "label": "温度",
          "type": "number",
          "min": 0,
          "max": 1,
          "step": 0.1
        },
        {
          "key": "maxTokens",
          "label": "输出上限",
          "type": "number",
          "min": 16,
          "max": 8192,
          "step": 1
        }
      ],
      "context": true,
      "backend": "openai"
    },
    "openai.translate": {
      "label": "API 翻译",
      "group": "model",
      "input": "text",
      "output": "text",
      "icon": "languages",
      "defaults": {
        "model": "",
        "sourceLanguage": "自动检测",
        "targetLanguage": "中文",
        "temperature": 0.1,
        "maxTokens": 1024,
        "contextSentences": 2
      },
      "fields": [
        {
          "key": "model",
          "label": "模型",
          "type": "text",
          "placeholder": "默认模型"
        },
        {
          "key": "sourceLanguage",
          "label": "源语言",
          "type": "text"
        },
        {
          "key": "targetLanguage",
          "label": "目标语言",
          "type": "text"
        },
        {
          "key": "temperature",
          "label": "温度",
          "type": "number",
          "min": 0,
          "max": 1,
          "step": 0.1
        },
        {
          "key": "maxTokens",
          "label": "输出上限",
          "type": "number",
          "min": 16,
          "max": 8192,
          "step": 1
        },
        {
          "key": "contextSentences",
          "label": "上下文句数",
          "type": "number",
          "min": 0,
          "max": 8
        }
      ],
      "context": true,
      "backend": "openai"
    },
    "openai.asr": {
      "label": "API 识别",
      "group": "model",
      "input": "audio",
      "output": "text",
      "icon": "mic",
      "defaults": {
        "model": "",
        "language": ""
      },
      "fields": [
        {
          "key": "model",
          "label": "服务模型",
          "type": "text"
        },
        {
          "key": "language",
          "label": "语言",
          "type": "text",
          "placeholder": "自动检测"
        }
      ],
      "backend": "openai"
    },
    "openai.tts": {
      "label": "API 合成",
      "group": "model",
      "input": "text",
      "output": "audio",
      "icon": "volume",
      "defaults": {
        "model": "",
        "voice": "",
        "speed": 1
      },
      "fields": [
        {
          "key": "model",
          "label": "服务模型",
          "type": "text"
        },
        {
          "key": "voice",
          "label": "音色",
          "type": "text"
        },
        {
          "key": "speed",
          "label": "语速",
          "type": "number",
          "min": 0.25,
          "max": 4,
          "step": 0.05
        }
      ],
      "backend": "openai"
    }
  },
  "templates": [
    {
      "id": "openai.chat",
      "label": "API 文本对话",
      "nodes": [
        {
          "kind": "text-input"
        },
        {
          "kind": "openai.text",
          "config": {
            "rememberHistory": true
          }
        },
        {
          "kind": "text-output"
        }
      ]
    }
  ]
}
